---
import Base from '../layouts/BaseLayout.astro';
---
<Base title="Page not found" description="Find the right ApplyKit tool or return to the homepage." noIndex>
  <section class="article shell">
    <h1>Page not found</h1><p>The address may have changed. Open the tool search or return to the homepage to find what you need.</p>
    <div class="actions"><a class="button primary no-underline" href="/">Go to homepage</a><a class="button secondary no-underline" href="/#categories">Browse categories</a></div>
  </section>
</Base>
