---
import {ads} from '../config/ads';
interface Props { placement: keyof typeof ads.slots }
const {placement}=Astro.props;
const id=ads.slots[placement];
---
{ads.enabled && id && <aside class:list={['ad-slot','ad-'+placement]} aria-label="Advertisement" data-ad-slot={id} data-ad-client={ads.publisher} hidden><small>Advertisement</small><ins class="adsbygoogle" style="display:block" data-ad-client={ads.publisher} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins></aside>}
