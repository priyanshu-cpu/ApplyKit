---
import {ads, analytics} from '../config/ads';
---
{(ads.enabled || analytics.enabled) && <div class="privacy-control" data-publisher={ads.enabled ? ads.publisher : ''} data-container={analytics.enabled ? analytics.container : ''} data-measurement={analytics.enabled ? analytics.measurement : ''}>
  <button type="button" class="button secondary" data-privacy-open>Privacy preferences</button>
  <dialog aria-labelledby="privacy-title">
    <h2 id="privacy-title">Privacy preferences</h2>
    <p>Optional services can use cookies or similar storage. Your selected files and their contents are excluded.</p>
    <form method="dialog">
      {analytics.enabled && <label class="check-field"><input name="analytics" type="checkbox"/> Allow analytics</label>}
      {ads.enabled && <p>Advertising is managed through the site’s consent provider when configured. <a href="/privacy-policy/">Privacy policy</a></p>}
      <button class="button primary" value="save">Save preferences</button>
    </form>
  </dialog>
</div>}
<script>
  const control = document.querySelector<HTMLElement>('.privacy-control');
  const appendScript = (url: string) => { const script = document.createElement('script'); script.async = true; script.src = url; document.head.append(script); return script; };
  const state = window as Window & { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void; adsbygoogle?: unknown[]; __applyKitAdsConsent?: boolean };
  if (control) {
    const dialog = control.querySelector('dialog')!;
    const check = dialog.querySelector<HTMLInputElement>('input');
    const key = 'applykit-analytics-consent';
    let consent = '';
    let adsLoaded = false;
    let analyticsLoaded = false;
    try { consent = localStorage.getItem(key) || ''; } catch {}
    const measurement = control.dataset.measurement;
    const container = control.dataset.container;
    const publisher = control.dataset.publisher;
    const activateAnalytics = () => {
      if ((!container && !measurement) || analyticsLoaded) return;
      analyticsLoaded = true;
      state.dataLayer ??= [];
      function gtag(..._args: unknown[]) { state.dataLayer!.push(arguments); }
      state.gtag = gtag;
      gtag('js', new Date());
      if (container) {
        gtag('set', {page_location:location.origin+location.pathname, page_referrer:''});
        state.dataLayer.push({'gtm.start': Date.now(), event: 'gtm.js'});
        appendScript('https://www.googletagmanager.com/gtm.js?id='+encodeURIComponent(container));
        return;
      }
      if (!measurement) return;
      gtag('config', measurement, { send_page_view: false, allow_google_signals: false, allow_ad_personalization_signals: false });
      gtag('event', 'page_view', {page_location:location.origin+location.pathname, page_referrer:''});
      appendScript('https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(measurement));
    };
    const activateAds = () => {
      if (!publisher || adsLoaded) return;
      const slots = [...document.querySelectorAll<HTMLElement>('.ad-slot')];
      if (!slots.length) return;
      adsLoaded = true;
      const script = appendScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+encodeURIComponent(publisher));
      script.crossOrigin = 'anonymous';
      for (const slot of slots) slot.hidden = false;
      for (const _slot of slots) (state.adsbygoogle ??= []).push({});
    };
    if (consent === 'yes') activateAnalytics();
    if (state.__applyKitAdsConsent === true) activateAds();
    window.addEventListener('applykit:ads-consent', (event) => {
      if ((event as CustomEvent<boolean>).detail === true) activateAds();
      else if (adsLoaded) location.reload();
    });
    control.querySelector('[data-privacy-open]')?.addEventListener('click', () => {
      if (check) check.checked = consent === 'yes';
      dialog.returnValue = '';
      dialog.showModal();
    });
    dialog.addEventListener('close', () => {
      if (dialog.returnValue !== 'save' || !check) return;
      consent = check.checked ? 'yes' : 'no';
      try { localStorage.setItem(key,consent); } catch {}
      if (check.checked) activateAnalytics();
      else if (analyticsLoaded) location.reload();
    });
  }
</script>
